{
  "name": "@pydantic/logfire-auth-action",
  "version": "1.1.0",
  "private": true,
  "description": "Authenticate GitHub Actions with Logfire via OIDC token exchange (RFC 8693)",
  "author": "Pydantic Services Inc.",
  "repository": "github:pydantic/logfire-auth-action",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/main.ts src/cleanup.ts --bundle --platform=node --target=node24 --outdir=dist",
    "build": "pnpm run typecheck && pnpm run bundle",
    "watch": "esbuild src/main.ts src/cleanup.ts --bundle --platform=node --target=node24 --outdir=dist --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "all": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run bundle",
    "release": "node scripts/release.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "nock": "^14.0.15",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
